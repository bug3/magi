{
  "name": "@bug3/magi",
  "version": "0.3.0",
  "description": "Multi-Advisor Grounded Inference: three AI coding harnesses answer one brief blind. The council thinks; the orchestrator works.",
  "keywords": [
    "ai",
    "llm",
    "code-review",
    "second-opinion",
    "multi-model",
    "claude-code",
    "codex",
    "grok",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bug3/magi.git"
  },
  "license": "MIT",
  "author": "bug3 (https://github.com/bug3)",
  "type": "module",
  "bin": {
    "magi": "bin/magi.js"
  },
  "files": [
    "bin",
    "dist",
    "prompts",
    "schemas",
    "skills",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build",
    "preflight": "publish-preflight",
    "prepublishOnly": "npm run check && npm run preflight"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "publish-preflight": "0.1.0",
    "typescript": "5.9.3"
  }
}
